# ─── Server ───────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────
# Get this from https://neon.tech after creating your project
DATABASE_URL="postgresql://user:password@host/medirenova?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
COOKIE_SECRET="change-me-in-production-min-32-chars"

# ─── Cloudflare R2 ────────────────────────────────────────────
# https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="medirenova-storage"
R2_PUBLIC_URL="https://your-bucket.your-account.r2.cloudflarestorage.com"

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────
# https://developers.facebook.com/docs/whatsapp/cloud-api
META_WA_PHONE_NUMBER_ID="your-phone-number-id"
META_WA_ACCESS_TOKEN="your-permanent-access-token"
META_WA_TEMPLATE_RENEWAL="medirenova_renewal_reminder"  # template name

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ─── Encryption ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
DNI_ENCRYPTION_KEY="change-me-64-hex-chars-for-aes256"

# ─── Email (Resend) ───────────────────────────────────────────
# Sin estas dos variables el email queda en modo demo (se registra, no se envía).
# Guía paso a paso (dominio, DNS, clave): docs/mensajeria.md
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="MediRenova <avisos@tudominio.es>"

# ─── Mensajería (pendientes de Fase A/B, ver openspec/changes/crm-mensajeria) ─
# CONFIG_ENCRYPTION_KEY="<64 hex: openssl rand -hex 32>"   # cifrado de tokens de proveedor por clínica
# META_WA_VERIFY_TOKEN="<cadena aleatoria>"                 # verificación del webhook de Meta
# RESEND_WEBHOOK_SECRET="<secreto de Resend>"               # firma del webhook de Resend
